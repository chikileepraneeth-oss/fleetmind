# Copy this file to .env and fill it in (.env is never committed).
#
# The AI supervisor's model. Free options:
#   groq        free tier: console.groq.com (pick a model that supports tool use)
#   gemini      free tier: aistudio.google.com
#   openrouter  free models (names end in :free): openrouter.ai
#   ollama      runs on your own computer, no key, no limits (slow on a laptop): ollama.com
# Paid: anthropic (Claude; set ANTHROPIC_API_KEY instead of AI_API_KEY).
AI_PROVIDER=groq
AI_MODEL=
AI_API_KEY=

# Only for AI_PROVIDER=openai (any other OpenAI-compatible service):
# AI_BASE_URL=https://example.com/v1

# The AI is only used with python -m web.server --agent. The public demo (--public) never runs
# an LLM and never reads this file's AI settings.
