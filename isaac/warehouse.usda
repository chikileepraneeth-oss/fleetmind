    def "Looks"
    {
        def Material "floor"
        {
            token outputs:surface.connect = </World/Looks/floor/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82, 0.83, 0.85)
                float inputs:roughness = 0.7
                token outputs:surface
            }
