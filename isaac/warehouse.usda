            token outputs:surface.connect = </World/Looks/shelf_D/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.65, 0.9)
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

