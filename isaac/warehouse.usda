    def "Staff"
    {
        def Cube "Desk" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom int2 fleetmind:cell = (11, 1)
            custom string fleetmind:kind = "desk"
            rel material:binding = </World/Looks/desk>
            color3f[] primvars:displayColor = [(0.55, 0.4, 0.28)]
            double size = 1
            float3 xformOp:scale = (0.8, 0.45, 0.75)
            double3 xformOp:translate = (1.5, -11.5, 0.375)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

